# Copy to .env for local development (loaded by cmd/server).

# Postgres connection string. Matches docker-compose.yml in the repo root.
# On Vercel use the pooled connection string from Neon (Storage tab).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth?sslmode=disable

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me

PORT=8080
